<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="Lexora AI"
    Manufacturer="Lexora Labs"
    Language="1033"
    Version="$(var.ProductVersion)"
    UpgradeCode="cf2de8a4-5c1a-4f8b-9d2e-1a2b3c4d5e6f">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- UI -->
    <Property Id="INSTALLLEVEL" Value="1" />
    <!-- IMPORTANT: bind WiX UI "InstallDir" to your application folder -->
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Features -->
    <Feature
      Id="MainFeature"
      Title="Lexora AI"
      Description="Lexora AI desktop application."
      Level="1"
      Display="expand"
      Absent="disallow"
      ConfigurableDirectory="APPLICATIONFOLDER">

      <!-- Harvested files from heat.exe (PyInstaller onedir dist\LexoraAI\...) -->
      <ComponentGroupRef Id="LexoraComponents" />

      <!-- Always install Start Menu shortcut -->
      <ComponentRef Id="StartMenuShortcut" />

      <!-- Optional Desktop shortcut -->
      <Feature
        Id="DesktopShortcutFeature"
        Title="Desktop shortcut"
        Description="Create a desktop shortcut for Lexora AI."
        Level="1"
        Absent="allow"
        InstallDefault="local">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>

    </Feature>

    <!-- Icons -->
    <Icon Id="LexoraIcon" SourceFile="lexora-ai-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LexoraIcon" />

  </Product>

  <!-- ========================================================= -->
  <!-- Directories: Install path under Program Files (x64)        -->
  <!-- ========================================================= -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="COMPANYFOLDER" Name="Lexora Labs">
          <Directory Id="APPLICATIONFOLDER" Name="Lexora AI" />
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <!-- ========================================================= -->
  <!-- All-users Start Menu folder (do NOT nest under TARGETDIR) -->
  <!-- ========================================================= -->
  <Fragment>
    <DirectoryRef Id="CommonProgramsFolder">
      <Directory Id="StartMenuDir" Name="Lexora AI" />
    </DirectoryRef>
  </Fragment>

  <!-- ========================================================= -->
  <!-- Shortcuts (per-machine): Start Menu + optional Desktop     -->
  <!-- ========================================================= -->
  <Fragment>

    <!-- Start Menu shortcut (All Users) -->
    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="*">
      <!-- Ensure folder exists even if empty -->
      <CreateFolder />

      <Shortcut
        Id="StartMenuShortcut"
        Name="Lexora AI"
        Description="Launch Lexora AI"
        Target="[APPLICATIONFOLDER]LexoraAI.exe"
        WorkingDirectory="APPLICATIONFOLDER"
        Icon="LexoraIcon"
        Advertise="no" />

      <RemoveFolder Id="RemoveStartMenuDir" Directory="StartMenuDir" On="uninstall" />

      <!-- Per-machine KeyPath (HKLM) -->
      <RegistryValue
        Root="HKLM"
        Key="Software\LexoraLabs\LexoraAI\Shortcuts"
        Name="StartMenu"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut (All Users) -->
    <!-- Uses CommonDesktopFolder directly, so it is not "user profile". -->
    <Component Id="DesktopShortcut" Directory="CommonDesktopFolder" Guid="*">

      <Shortcut
        Id="DesktopShortcut"
        Name="Lexora AI"
        Description="Launch Lexora AI"
        Target="[APPLICATIONFOLDER]LexoraAI.exe"
        WorkingDirectory="APPLICATIONFOLDER"
        Icon="LexoraIcon"
        Advertise="no" />

      <!-- Per-machine KeyPath (HKLM) -->
      <RegistryValue
        Root="HKLM"
        Key="Software\LexoraLabs\LexoraAI\Shortcuts"
        Name="Desktop"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

  </Fragment>

</Wix>
