<?xml version="1.0" encoding="UTF-8"?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">

  <Product
    Id="*"
    Name="Lexora AI"
    Manufacturer="Lexora Labs"
    Language="1033"
    Version="$(var.ProductVersion)"
    UpgradeCode="cf2de8a4-5c1a-4f8b-9d2e-1a2b3c4d5e6f">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- UI -->
    <Property Id="INSTALLLEVEL" Value="1" />
    <!-- IMPORTANT: bind WiX UI "InstallDir" to your application folder -->
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <UIRef Id="WixUI_FeatureTree" />
    <UIRef Id="WixUI_ErrorProgressText" />

    <!-- Features -->
    <Feature
      Id="MainFeature"
      Title="Lexora AI"
      Description="Lexora AI desktop application."
      Level="1"
      Display="expand"
      Absent="disallow"
      ConfigurableDirectory="APPLICATIONFOLDER">

      <!-- Harvested files from heat.exe (PyInstaller onedir dist\LexoraAI\...) -->
      <ComponentGroupRef Id="LexoraComponents" />

      <!-- Always install Start Menu shortcut -->
      <ComponentRef Id="StartMenuShortcut" />

      <!-- Optional Desktop shortcut -->
      <Feature
        Id="DesktopShortcutFeature"
        Title="Desktop shortcut"
        Description="Create a desktop shortcut for Lexora AI."
        Level="1"
        Absent="allow"
        InstallDefault="local">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>

    </Feature>

    <!-- Icons -->
    <Icon Id="LexoraIcon" SourceFile="lexora-ai-icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="LexoraIcon" />

  </Product>

  <!-- ========================================================= -->
  <!-- Directories: Install path under Program Files (x64)        -->
  <!-- ========================================================= -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="COMPANYFOLDER" Name="Lexora Labs">
          <Directory Id="APPLICATIONFOLDER" Name="Lexora AI" />
        </Directory>
      </Directory>
      <!-- IMPORTANT (regression guard, see LAI-B-013):
           Use ProgramMenuFolder / DesktopFolder, NOT CommonProgramsFolder /
           CommonDesktopFolder. With InstallScope="perMachine" (ALLUSERS=1),
           Windows Installer auto-redirects these to the All Users locations.
           Explicit Common* ids resolve to the install drive root (e.g. D:\)
           when the MSI is launched from a non-system drive, so shortcuts end
           up at "D:\Lexora Labs\Lexora AI" instead of the Start Menu. -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="StartMenuDir" Name="Lexora AI" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>
  </Fragment>

  <!-- ========================================================= -->
  <!-- Non-advertised shortcuts → all-users Start Menu / Desktop          -->
  <!--   ALLUSERS=1 (perMachine) redirects ProgramMenuFolder/DesktopFolder -->
  <!--   to Common* automatically; do NOT hard-code Common* ids (LAI-B-013) -->
  <!-- Target: stable File Id from heat + wix-patch-harvested.ps1          -->
  <!-- WiX cannot use Advertise=yes with Target=[#file] (CNDL0035).        -->
  <!-- HKLM KeyPath + ProgramMenuFolder shortcuts trip ICE38/43/57;        -->
  <!-- light uses -sval. HKCU made shortcuts vanish on per-machine.        -->
  <!-- ========================================================= -->
  <Fragment>

    <Component Id="StartMenuShortcut" Directory="StartMenuDir" Guid="*">
      <CreateFolder />
      <Shortcut
        Id="StartMenuShortcut"
        Name="Lexora AI"
        Description="Launch Lexora AI"
        Target="[#LexoraAILauncherExe]"
        WorkingDirectory="APPLICATIONFOLDER"
        Icon="LexoraIcon"
        Advertise="no" />
      <RemoveFolder Id="RemoveStartMenuDir" Directory="StartMenuDir" On="uninstall" />
      <RegistryValue
        Root="HKLM"
        Key="Software\LexoraLabs\LexoraAI\Shortcuts"
        Name="StartMenu"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut
        Id="DesktopShortcut"
        Name="Lexora AI"
        Description="Launch Lexora AI"
        Target="[#LexoraAILauncherExe]"
        WorkingDirectory="APPLICATIONFOLDER"
        Icon="LexoraIcon"
        Advertise="no" />
      <RegistryValue
        Root="HKLM"
        Key="Software\LexoraLabs\LexoraAI\Shortcuts"
        Name="Desktop"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

  </Fragment>

</Wix>
